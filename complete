  { product: '7/6 ARM', rate: 5.99, change: -0.015 },
  { product: '10/6 ARM', rate: 6.125, change: 0.0 },
  { product: 'Bank Statement 30-Yr', rate: 7.125, change: 0.02 },
  { product: 'Non-QM 30-Yr', rate: 7.375, change: 0.015 },
