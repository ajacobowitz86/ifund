# Google Maps browser key for US address autocomplete (NY, NJ, PA, CT, FL).
# Enable Maps JavaScript API and Places API (New) on the same Cloud project
# that owns this key. Restrict HTTP referrers to include http://localhost:3000/*
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optimal Blue PPE credentials (optional — 24h board refresh in ppe-rates-cache)
# OPTIMAL_BLUE_CLIENT_ID=
# OPTIMAL_BLUE_CLIENT_SECRET=
# OPTIMAL_BLUE_BASE_URL=
